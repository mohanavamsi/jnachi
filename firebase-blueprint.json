{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["email", "createdAt", "updatedAt"]
    },
    "Score": {
      "title": "Score",
      "description": "A past Jnachi score result",
      "type": "object",
      "properties": {
        "score": { "type": "number" },
        "level": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["score", "level", "createdAt"]
    },
    "Certification": {
      "title": "Certification",
      "description": "A saved certification",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "issuedAt": { "type": "number" },
        "url": { "type": "string", "maxLength": 500 }
      },
      "required": ["title", "issuedAt"]
    },
    "CertProfile": {
      "title": "CertProfile",
      "description": "Certification user profile tracking multi-tier attempts, cooldowns, and pass status",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 200 },
        "totalAttempts": { "type": "number" },
        "lastAttemptAt": { "type": "number" },
        "passed": { "type": "boolean" },
        "highestScore": { "type": "number" },
        "latestCertificateId": { "type": "string", "maxLength": 50 },
        "usedQuestionIds": { "type": "array", "items": { "type": "string" } },
        "tierProgress": { "type": "object" }
      },
      "required": ["email"]
    },
    "CertAttempt": {
      "title": "CertAttempt",
      "description": "An individual 40-question certification exam attempt for a specific tier",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "tier": { "type": "string", "maxLength": 30 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 200 },
        "attemptNumber": { "type": "number" },
        "status": { "type": "string", "maxLength": 30 },
        "startedAt": { "type": "number" },
        "completedAt": { "type": "number" },
        "lastSyncedAt": { "type": "number" },
        "score": { "type": "number" },
        "percentage": { "type": "number" },
        "passed": { "type": "boolean" },
        "certificateId": { "type": "string", "maxLength": 50 },
        "questionIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["email", "attemptNumber", "status", "startedAt", "questionIds"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles"
    },
    "/users/{userId}/scores/{scoreId}": {
      "schema": { "$ref": "#/entities/Score" },
      "description": "Stores user's past scores"
    },
    "/users/{userId}/certifications/{certId}": {
      "schema": { "$ref": "#/entities/Certification" },
      "description": "Stores user's saved certifications"
    },
    "/cert_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/CertProfile" },
      "description": "Stores user exam attempt counts, cooldown timestamps, and passing certification status across tiers"
    },
    "/cert_attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/CertAttempt" },
      "description": "Stores individual exam attempt questions, answers, tier, and scores"
    }
  }
}
